# Optional. Leave unset to use manual address entry.
# For production, point this at YOUR backend route that holds the private geocoding key (see server/geocode-proxy.example.mjs).
# Never put a private API key in a VITE_* variable: everything prefixed VITE_ is shipped to the browser.
VITE_GEOCODE_ENDPOINT=

# Frontend API URL (local Express backend).
# FreshNest backend API
VITE_API_URL=http://localhost:4000/api


# Optional alternative tile provider (public browser values only, attribution required)
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
