NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/freshnest?schema=public"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
AUTH_DEV_OTP=false

# Use AUTH_DEV_OTP=false for public deployments. Local development can show a test code if Resend is unset.
RESEND_API_KEY=
RESEND_FROM=
# Google OAuth Web client ID. Add the frontend origin in the Google Cloud console.
GOOGLE_CLIENT_ID=
# Start with a Razorpay test-mode key pair.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Assign packed orders to an available, idle partner if enabled.
AUTO_ASSIGN_DELIVERY=false

# Distance-based pricing (opt-in, straight-line; not road distance)
DELIVERY_PER_KM=0
DELIVERY_INCLUDED_KM=2
DELIVERY_SPEED_KMH=20
DELIVERY_PREP_MINUTES=10
# Actual central fulfilment coordinates, required for central-stock distance calculation
FULFILMENT_LAT=
FULFILMENT_LON=
